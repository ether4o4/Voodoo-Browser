BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
BRIDGE_PUBLIC_URL=https://bridge.example.com
BRIDGE_STATE_FILE=./data/state.json
# Generate three different secrets, each at least 32 characters. Never commit them.
BRIDGE_ADMIN_SECRET=
BRIDGE_OWNER_SECRET=
BRIDGE_OAUTH_CLIENT_ID=voodoo-chatgpt
BRIDGE_OAUTH_CLIENT_SECRET=
# Copy the exact callback URL displayed by the MCP client; no wildcard redirects.
BRIDGE_OAUTH_REDIRECT_URIS=
